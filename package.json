{
    "name": "token-drift",
    "version": "0.1.0-beta.1",
    "description": "ESLint plugin to detect design token drift (near-miss hardcoded spacing/color values) without strict blocking.",
    "type": "module",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "prepublishOnly": "npm test && npm run lint"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "design-tokens",
        "design-system",
        "css",
        "react"
    ],
    "license": "MIT",
    "peerDependencies": {
        "eslint": ">=8.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.9.0",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "token-drift": "link:"
    }
}
